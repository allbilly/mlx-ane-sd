+// Record the actual request surfaces; these are not device IOVAs or BAR mappings.
+static NSDictionary *surface_binding(IOSurfaceRef surface, NSDictionary *tensor,
+                                      NSString *role, int index, NSString *out) {
+    size_t bytes=IOSurfaceGetAllocSize(surface);
+    NSString *file=[NSString stringWithFormat:@"initial-%@-%d.bin",role,index];
+    IOSurfaceLock(surface,kIOSurfaceLockReadOnly,NULL);
+    [[NSData dataWithBytes:IOSurfaceGetBaseAddress(surface) length:bytes]
+        writeToFile:[out stringByAppendingPathComponent:file] atomically:YES];
+    IOSurfaceUnlock(surface,kIOSurfaceLockReadOnly,NULL);
+    NSArray *shape=tensor[@"shape"];
+    size_t channels=[shape[1] unsignedLongLongValue], seq=[shape[3] unsignedLongLongValue];
+    NSMutableArray *planes=[NSMutableArray array];
+    for(size_t p=0;p<IOSurfaceGetPlaneCount(surface);p++) {
+        [planes addObject:@{@"index":@(p),@"width":@(IOSurfaceGetWidthOfPlane(surface,p)),
+            @"height":@(IOSurfaceGetHeightOfPlane(surface,p)),
+            @"bytes_per_row":@(IOSurfaceGetBytesPerRowOfPlane(surface,p)),
+            @"bytes_per_element":@(IOSurfaceGetBytesPerElementOfPlane(surface,p))}];
+    }
+    return @{@"role":role,@"request_index":@(index),@"name":tensor[@"name"],
+        @"dtype":@"float16",@"shape":shape,@"logical_bytes":@(channels*seq*2),
+        @"physical_strides_bytes":@[@(channels*seq*2),@(seq*2),@(seq*2),@2],
+        @"iosurface_id":@(IOSurfaceGetID(surface)),@"allocation_bytes":@(bytes),
+        @"width":@(IOSurfaceGetWidth(surface)),@"height":@(IOSurfaceGetHeight(surface)),
+        @"bytes_per_row":@(IOSurfaceGetBytesPerRow(surface)),
+        @"bytes_per_element":@(IOSurfaceGetBytesPerElement(surface)),@"planes":planes,
+        @"initial_payload":file,@"device_iova":NSNull.null,@"logical_bar":NSNull.null};
 }
 
